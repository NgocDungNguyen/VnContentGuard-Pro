{
  "manifest_version": 3,
  "name": "VnContentGuard Pro v4.0",
  "version": "4.0.0",
  "description": "Quét an toàn nội dung tiếng Việt bằng AI — phân tích bình luận, phát hiện độc hại, kiểm tra thực tế, chấm điểm rủi ro.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "downloads"
  ],
  "host_permissions": [
    "http://localhost:8000/*",
    "http://127.0.0.1:8000/*",
    "https://vncontentguard-pro.onrender.com/*",
    "https://*.facebook.com/*",
    "https://*.vnexpress.net/*",
    "https://*.dantri.com.vn/*",
    "https://*.tuoitre.vn/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "VnContentGuard Pro - Quét an toàn nội dung",
    "default_icon": {
      "16": "icons/icon.png",
      "48": "icons/icon.png",
      "128": "icons/icon.png"
    }
  },
  "icons": {
    "16": "icons/icon.png",
    "48": "icons/icon.png",
    "128": "icons/icon.png"
  }
}