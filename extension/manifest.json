{
  "manifest_version": 3,
  "name": "VnContentGuard Pro v5.0",
  "version": "5.0.0",
  "description": "Quét an toàn nội dung tiếng Việt bằng AI — phân tích thống nhất, streaming, YouTube/TikTok, overlay nội dung, kiểm soát gia đình, blocklist cộng đồng.",
  "permissions": [
    "activeTab",
    "tabs",
    "scripting",
    "storage",
    "notifications",
    "webNavigation",
    "alarms"
  ],
  "host_permissions": [
    "https://vncontentguard-pro.onrender.com/*",
    "https://*.facebook.com/*",
    "https://*.vnexpress.net/*",
    "https://*.dantri.com.vn/*",
    "https://*.tuoitre.vn/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "VnContentGuard Pro - Quét an toàn nội dung",
    "default_icon": {
      "16": "icons/icon.png",
      "48": "icons/icon.png",
      "128": "icons/icon.png"
    }
  },
  "icons": {
    "16": "icons/icon.png",
    "48": "icons/icon.png",
    "128": "icons/icon.png"
  }
}