{
  "manifest_version": 3,
  "name": "VnContentGuard Pro v5.0",
  "version": "5.0.0",
  "description": "Phân tích an toàn nội dung tiếng Việt bằng AI: thống nhất, streaming, YouTube/TikTok, overlay, kiểm soát gia đình & blocklist.",
  "permissions": [
    "activeTab",
    "tabs",
    "scripting",
    "storage",
    "notifications",
    "webNavigation",
    "alarms"
  ],
  "host_permissions": [
    "https://vncontentguard-pro.onrender.com/*",
    "https://*.facebook.com/*",
    "https://*.vnexpress.net/*",
    "https://*.dantri.com.vn/*",
    "https://*.tuoitre.vn/*",
    "https://*.thanhnien.vn/*",
    "https://*.24h.com.vn/*",
    "https://*.vietnamnet.vn/*",
    "https://*.baomoi.com/*",
    "https://*.youtube.com/*",
    "https://*.tiktok.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*.facebook.com/*",
        "https://*.vnexpress.net/*",
        "https://*.dantri.com.vn/*",
        "https://*.tuoitre.vn/*",
        "https://*.thanhnien.vn/*",
        "https://*.24h.com.vn/*",
        "https://*.vietnamnet.vn/*",
        "https://*.baomoi.com/*",
        "https://*.youtube.com/*",
        "https://*.tiktok.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["content.css", "icons/*"],
      "matches": [
        "https://*.facebook.com/*",
        "https://*.vnexpress.net/*",
        "https://*.dantri.com.vn/*",
        "https://*.tuoitre.vn/*",
        "https://*.thanhnien.vn/*",
        "https://*.24h.com.vn/*",
        "https://*.vietnamnet.vn/*",
        "https://*.baomoi.com/*",
        "https://*.youtube.com/*",
        "https://*.tiktok.com/*"
      ]
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "VnContentGuard Pro - Quét an toàn nội dung",
    "default_icon": {
      "16": "icons/icon.png",
      "48": "icons/icon.png",
      "128": "icons/icon.png"
    }
  },
  "icons": {
    "16": "icons/icon.png",
    "48": "icons/icon.png",
    "128": "icons/icon.png"
  }
}